# WebSocket server tokens for Boost.Beast websocket::stream::accept fuzzing.
# The input first drives the opening HTTP/1.1 Upgrade handshake (parsed as an HTTP request), then a
# WebSocket frame. Tokens cover the handshake headers and the permessage-deflate extension.
# libFuzzer dict format: CR/LF are written as \x0d\x0a (no \r/\n shorthand).
"GET / HTTP/1.1"
"\x0d\x0a"
"\x0d\x0a\x0d\x0a"
"Host: "
"Upgrade: "
"websocket"
"Connection: "
"Upgrade"
"Sec-WebSocket-Key: "
"Sec-WebSocket-Version: "
"13"
"Sec-WebSocket-Extensions: "
"permessage-deflate"
"client_max_window_bits"
"server_max_window_bits"
"client_no_context_takeover"
"server_no_context_takeover"
"Sec-WebSocket-Protocol: "
"dGhlIHNhbXBsZSBub25jZQ=="
";"
"="
"x-webkit-deflate-frame"
