# HTTP request tokens for Boost.Beast http::request_parser fuzzing.
# Methods, version, line terminators, and common request headers (chunked-body parsing is the
# interesting path). libFuzzer dict format: CR/LF are written as \x0d\x0a (no \r/\n shorthand).
"GET "
"POST "
"PUT "
"HEAD "
"DELETE "
"OPTIONS "
"CONNECT "
"TRACE "
"PATCH "
" HTTP/1.0"
" HTTP/1.1"
"\x0d\x0a"
"\x0d\x0a\x0d\x0a"
"Host: "
"Content-Length: "
"Transfer-Encoding: "
"chunked"
"identity"
"Connection: "
"keep-alive"
"close"
"Content-Type: "
"Expect: "
"100-continue"
"Upgrade: "
"0\x0d\x0a\x0d\x0a"
";"
"="
